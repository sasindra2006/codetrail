{
  "name": "codetrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "auth:generate-schema": "auth generate --yes --config src/lib/auth-schema-config.ts --adapter drizzle --dialect mysql --output src/lib/db/auth-schema.ts",
    "db:generate": "node --env-file=.env.local scripts/drizzle.mjs generate",
    "db:migrate": "node --env-file=.env.local scripts/drizzle.mjs migrate"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "better-auth": "1.7.15",
    "dockview-react": "^8.5.1",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "monaco-editor": "^0.57.0",
    "mysql2": "^3.24.6",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.15",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
