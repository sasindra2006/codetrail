# Base URL for a Judge0 CE instance, for example https://ce.judge0.com
JUDGE0_API_URL=

# Optional. Used as the X-Auth-Token header for protected Judge0 instances.
JUDGE0_API_KEY=

# Judge0 language ID for C++17 (GNU G++17).
JUDGE0_CPP17_LANGUAGE_ID=54

# Judge0 language ID for Python 3 (Python 3.11.2 on the configured instance).
JUDGE0_PYTHON3_LANGUAGE_ID=92

# MySQL connection string. Keep this server-side; never prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# Better Auth session signing secret (generate a unique random value for each environment).
BETTER_AUTH_SECRET=

# Public application origin used for OAuth callback URLs.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth web client credentials (optional until Google sign-in is configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini Developer API (server-side only; do not use NEXT_PUBLIC_ prefixes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TUTOR_DAILY_REQUEST_LIMIT=20
